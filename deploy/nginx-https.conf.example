# 备案生效后的正式入口配置（HTTPS + 双模块）
# 放置路径：/etc/nginx/conf.d/finance.conf（由 deploy/switch-https.sh 自动安装）
# 前置：Let's Encrypt 证书已由 deploy/issue-cert.sh 签发
#
# 结构：
#   80  域名 -> acme-challenge 保留 + 其余 301 到 https
#   443 域名 -> 完整双模块路由（/refund/ 到 Node，其余到 Flask）
#   5050     -> 原样保留，兼容此前已发出的 http://IP:5050/refund/ 签字链接
#
# 注意：不要在此配置 HSTS。HSTS 按主机名（不含端口）生效，会让浏览器
#       把 http://lexueisland.site:5050 也强制升级为 https，导致旧链接失效。
#       待旧链接全部失效后再考虑启用。

server {
    listen 80;
    server_name lexueisland.site;

    # Let's Encrypt HTTP-01 续期验证，必须优先于 301 跳转
    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
        default_type "text/plain";
    }

    # 微信公众平台域名验证文件：必须能在 80 根目录直接读取，不能被 301 带走。
    # 文件放到 /usr/share/nginx/html/MP_verify_XXXXXXXX.txt（不入库）。
    location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
        root /usr/share/nginx/html;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name lexueisland.site;

    ssl_certificate     /etc/letsencrypt/live/lexueisland.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lexueisland.site/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 20m;

    # 微信公众平台域名验证文件（微信也可能通过 https 校验，故 443 同样托管）
    # 文件放到 /usr/share/nginx/html/MP_verify_XXXXXXXX.txt（不入库）。
    location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
        root /usr/share/nginx/html;
        default_type "text/plain";
    }

    # Flask 静态资源由 Nginx 直接提供
    location /static/ {
        alias /home/fin/fin/static/;
        expires 7d;
    }

    # 退费审核模块（独立 Node 服务，仅监听回环 3000）
    location /refund/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Flask 主模块
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# 旧入口：保留 HTTP:5050，供已发出的 IP 签字链接继续可用。
# 确认历史链接全部失效后，可改为 301 到 https 并移除对外放行。
server {
    listen 5050;
    server_name _;

    client_max_body_size 20m;

    location /static/ {
        alias /home/fin/fin/static/;
        expires 7d;
    }

    location /refund/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
