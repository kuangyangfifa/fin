# fin-remark 双模块 Nginx 配置示例
# 放置路径：/etc/nginx/conf.d/fin-remark.conf
# 使用前把 your-domain.com 替换为实际域名。
#
# 目录约定（Git 仓库根 = /home/fin/app，仓库内容直接是 app.py / static / refund 等）：
#   Flask 主模块  /home/fin/app             Gunicorn 127.0.0.1:8000
#   退费模块      /home/fin/app/refund      Node     127.0.0.1:3000
#   数据          /home/fin/data            （与代码分离）

server {
    listen 80;
    server_name your-domain.com;

    access_log /home/fin/logs/nginx-access.log;
    error_log  /home/fin/logs/nginx-error.log;

    # 退费单附件以 dataURL 提交，单请求最大 60MB，预留余量
    client_max_body_size 80m;

    # Flask 静态资源
    location /static {
        alias /home/fin/app/static;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 退费审核模块：不带尾斜杠访问时补齐，保证相对资源与 hash 路由正常
    location = /refund { return 301 /refund/; }

    # proxy_pass 末尾不加斜杠，把 /refund/... 原样交给 Node，
    # 由 server.js 的 REFUND_BASE_PATH 逻辑剥离前缀。
    location /refund/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Flask 主模块
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
